    "Each backup is a full copy of your library. iOS picks the exact time, usually while charging on Wi-Fi.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每份备份都是图库的完整副本。具体时间由 iOS 决定，通常在连接 Wi-Fi 充电时。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各バックアップはライブラリ全体のコピーです。正確な時刻は iOS が決めます。通常は Wi-Fi 接続で充電中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 백업은 라이브러리 전체의 사본입니다. 정확한 시간은 iOS가 정하며, 보통 Wi-Fi에 연결해 충전할 때입니다."
          }
        }
      }
    },
    "Each finished backup shows here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的备份会显示在这里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したバックアップがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 백업이 여기에 표시됩니다."
          }
        }
      }
    },
