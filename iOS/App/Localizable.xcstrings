{
  "sourceLanguage": "en",
  "strings": {
    "%@ failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个失败"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 件失敗"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 실패"
          }
        }
      }
    },
    "%@ files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个文件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 件のファイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %@개"
          }
        }
      }
    },
    "%@ files uploaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已上传 %@ 个文件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 件のファイルをアップロード済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %@개 업로드됨"
          }
        }
      }
    },
    "%@ skipped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个跳过"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 件スキップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 건너뜀"
          }
        }
      }
    },
    "A full copy of your photo library in one folder. Each backup is complete on its own.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个文件夹中的完整图库副本。每份备份都可单独使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのフォルダに入ったライブラリ全体のコピー。各バックアップは単独で完結しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 폴더에 담긴 사진 보관함 전체 사본. 각 백업은 그 자체로 완전합니다."
          }
        }
      }
    },
    "Access key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问密钥"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスキー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액세스 키"
          }
        }
      }
    },
    "Access key and secret are required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问密钥和密钥。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスキーとシークレットが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액세스 키와 시크릿이 필요합니다."
          }
        }
      }
    },
    "Add storage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加存储"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージを追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토리지 추가"
          }
        }
      }
    },
    "Add your S3 or R2 storage to start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 S3 或 R2 存储即可开始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "S3 または R2 のストレージを追加して開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 S3 또는 R2 스토리지를 추가하세요."
          }
        }
      }
    },
    "Back up every": {
      "localizations": {
        "zh-Hans": {
