    "Changes are saved as you make them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会立即保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はすぐに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 바로 저장됩니다."
          }
        }
      }
    },
