    "Secret access key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密访问密钥"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットアクセスキー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시크릿 액세스 키"
          }
        }
      }
    },
    "See the app with sample backups. Nothing is uploaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用示例备份查看 App。不会上传任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルのバックアップでアプリを確認します。何もアップロードしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 백업으로 앱을 살펴봅니다. 아무것도 업로드하지 않습니다."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정"
          }
        }
      }
    },
    "Shoebox": {
      "shouldTranslate": false
    },
    "Shoebox keeps the latest %@ backups and deletes older ones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox 保留最近 %@ 份备份，并删除更早的备份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox は最新の %@ 件を保持し、古いバックアップを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox는 최근 백업 %@개를 보관하고 오래된 백업을 삭제합니다."
          }
        }
      }
    },
    "Shoebox needs Full Access to photos. Change it in Settings › Privacy › Photos.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox 需要照片的完全访问权限。请在“设置 › 隐私 › 照片”中更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox には写真へのフルアクセスが必要です。「設定 › プライバシー › 写真」で変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox에는 사진 전체 접근 권한이 필요합니다. 설정 › 개인정보 보호 › 사진에서 변경하세요."
          }
        }
      }
    },
    "Shoebox starts a new backup after the number of days you set. iOS picks the exact time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经过你设置的天数后，Shoebox 会开始新的备份。具体时间由 iOS 决定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した日数が過ぎると、Shoebox は新しいバックアップを開始します。正確な時刻は iOS が決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 일수가 지나면 Shoebox가 새 백업을 시작합니다. 정확한 시간은 iOS가 정합니다."
          }
        }
      }
    },
    "Show sample data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示示例数据"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 데이터 표시"
          }
        }
      }
    },
    "Showing sample data. Tap to turn it off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示示例数据。轻点以关闭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータを表示中。タップしてオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 데이터를 표시하는 중. 탭하여 끕니다."
          }
        }
      }
    },
    "Started %@. Continues in the background.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始于 %@。将在后台继续。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に開始。バックグラウンドで続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 시작. 백그라운드에서 계속됩니다."
          }
        }
      }
    },
    "Storage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토리지"
          }
        }
      }
    },
    "Test connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试连接"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続をテスト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 테스트"
          }
        }
      }
    },
    "The last file of each backup. A backup without it is not complete, and Shoebox never counts it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每份备份的最后一个文件。没有它的备份不完整，Shoebox 不会计入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各バックアップの最後のファイル。これがないバックアップは未完了で、Shoebox は数えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 백업의 마지막 파일. 이 파일이 없는 백업은 완료되지 않은 것으로, Shoebox가 세지 않습니다."
          }
        }
      }
    },
    "The short video in each Live Photo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张实况照片中的短视频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各 Live Photos の短いビデオ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 Live Photo의 짧은 비디오."
          }
        }
      }
    },
    "This build uploads only under %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本只上传到 %@ 之下。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドは %@ の下にのみアップロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드는 %@ 아래에만 업로드합니다."
          }
        }
      }
    },
    "Turn it on to back up while Shoebox is closed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，Shoebox 关闭时也会备份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、Shoebox を閉じていてもバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 Shoebox가 닫혀 있어도 백업합니다."
          }
        }
      }
    },
    "Turn on background backup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后台备份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドバックアップをオン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 백업 켜기"
          }
        }
      }
    },
    "Up to date": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已是最新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 상태"
          }
        }
      }
    },
    "Uploads continue when Shoebox is closed or the phone is locked.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox 关闭或手机锁定时，上传会继续。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox を閉じても、iPhone をロックしても、アップロードは続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoebox가 닫히거나 휴대폰이 잠겨도 업로드가 계속됩니다."
          }
        }
      }
    },
    "Videos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오"
          }
        }
      }
    },
    "Waiting for the first backup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待首次备份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のバックアップを待っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 백업 대기 중"
          }
        }
      }
    },
    "When a new backup is complete, Shoebox deletes the oldest backups above this number.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新备份完成后，Shoebox 会删除超出此数量的最旧备份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバックアップが完了すると、Shoebox はこの数を超えた古いバックアップを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 백업이 완료되면 Shoebox는 이 개수를 넘는 가장 오래된 백업을 삭제합니다."
          }
        }
      }
    },
    "Works with Cloudflare R2, AWS S3, MinIO and other S3-compatible storage. This build uploads only under %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 Cloudflare R2、AWS S3、MinIO 及其他 S3 兼容存储。此版本只上传到 %@ 之下。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare R2、AWS S3、MinIO などの S3 互換ストレージで使えます。このビルドは %@ の下にのみアップロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare R2, AWS S3, MinIO 등 S3 호환 스토리지에서 작동합니다. 이 빌드는 %@ 아래에만 업로드합니다."
          }
        }
      }
    },
    "Your edits, next to the original.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的编辑结果，与原件放在一起。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集結果をオリジナルの隣に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집본을 원본 옆에 저장합니다."
          }
        }
      }
    },
    "Your own S3-compatible bucket, for example Cloudflare R2. Shoebox needs a key that can read, write and delete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的 S3 兼容存储桶，例如 Cloudflare R2。Shoebox 需要可读、可写、可删除的密钥。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の S3 互換バケット（例：Cloudflare R2）。Shoebox には読み取り・書き込み・削除ができるキーが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 소유한 S3 호환 버킷(예: Cloudflare R2). Shoebox에는 읽기, 쓰기, 삭제가 가능한 키가 필요합니다."
          }
        }
      }
    },
    "^[%lld backup](inflect: true)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개"
          }
        }
      }
    },
    "^[%lld day](inflect: true)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일"
          }
        }
      }
    },
    "auto": {
      "shouldTranslate": false
    },
    "https://<account>.r2.cloudflarestorage.com": {
      "shouldTranslate": false
    },
    "iOS starts it soon, usually while charging on Wi-Fi.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 很快会开始，通常在连接 Wi-Fi 充电时。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がまもなく開始します。通常は Wi-Fi 接続で充電中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 곧 시작합니다. 보통 Wi-Fi에 연결해 충전할 때입니다."
          }
        }
      }
    },
    "iOS uploads the photos for Shoebox, also when the app is closed or the phone is locked.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 App 已关闭或手机已锁定，iOS 也会为 Shoebox 上传照片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じていても、iPhone をロックしていても、iOS が Shoebox の代わりに写真をアップロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 닫혀 있거나 휴대폰이 잠겨 있어도 iOS가 Shoebox 대신 사진을 업로드합니다."
          }
        }
      }
    },
    "photos": {
      "shouldTranslate": false
    }
  },
  "version": "1.0"
}